        subtitle = Text("Stateless State-Host Cybernetics", font_size=24).next_to(title, DOWN)
        self.play(Write(title), FadeIn(subtitle))
        self.wait(2)
        self.play(FadeOut(title), FadeOut(subtitle))

        # Node Animation - Origin Complex & Loops
        origin = Dot(point=ORIGIN, color=WHITE)
        origin_text = Text("Origin 0: Subtracted Space", font_size=18).next_to(origin, UP)
        self.play(Create(origin), Write(origin_text))
        
        # 3D Loop System Animation
        loop = Circle(radius=2.5, color=BLUE)
        loop_text = Text("3D Loop-Automating Environment", font_size=18).next_to(loop, DOWN)
        self.play(Create(loop), Write(loop_text))
        self.wait(1)

        # Formula Shift
        formula = MathTex(r"\text{negValue block} = -(\text{volume block})", font_size=36).move_to(ORIGIN)
        self.play(FadeOut(origin), FadeOut(origin_text), Transform(loop_text, formula))
        self.wait(2)
        
        # End Scene
        final_text = Text("Grey Agent Network: Initiated", font_size=32).color(GREEN)
        self.play(Transform(loop, final_text), FadeOut(loop_text))
        self.wait(2)


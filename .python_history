    INCOMING_DIR.mkdir(parents=True, exist_ok=True)
    for category in CATEGORIES:
        (BANK_DIR / category).mkdir(parents=True, exist_ok=True)
    (BANK_DIR / 'uncategorized').mkdir(parents=True, exist_ok=True)

